# net.i2p.crypto.eddsa optionally falls back to JDK-internal X509 key handling that
# doesn't exist on Android; that code path isn't exercised by this app's usage.
-dontwarn sun.security.x509.X509Key

# jnano ships as a plain jar with no consumer proguard rules. Its RPC request/response/model
# classes are populated by Gson via reflection on field names, so R8 renaming those fields
# silently leaves them null at runtime instead of failing the build.
-keep class uk.oczadly.karl.jnano.** { *; }
-keep class * implements com.google.gson.TypeAdapterFactory
-keep class * implements com.google.gson.JsonSerializer
-keep class * implements com.google.gson.JsonDeserializer
-keepattributes Signature,*Annotation*
-dontwarn sun.misc.**

# Keeping jnano's classes above makes R8 analyze its unused OpenCL work-generation path (the
# jocl artifact is deliberately excluded, see the jnano dependency in build.gradle.kts) and its
# optional slf4j logging binding lookup, which falls back gracefully to a no-op logger if absent.
-dontwarn org.jocl.**
-dontwarn org.slf4j.impl.StaticLoggerBinder
